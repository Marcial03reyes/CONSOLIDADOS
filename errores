  or(
    empty(items('Apply_to_each')?['FechaFin']),
    empty(items('Apply_to_each')?['HoraFin'])
  ),
  null,
  min(
    ticks(
      concat(
        outputs('Compose_FechaFin_ISO'),
        'T',
        items('Apply_to_each')?['HoraFin'],
        ':00'
      )
    ),
    ticks(
      concat(
        outputs('Compose_FechaFin_ISO'),
        'T',
        outputs('Compose_Close_Ajustado'),
        ':00'
      )
    )
  )
)
