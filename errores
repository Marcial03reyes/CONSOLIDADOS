max(
  ticks(concat(items('Aplicar_a_cada_uno')?['Fecha Inicio'], 'T', items('Aplicar_a_cada_uno')?['Hora Inicio'], ':00')),
  ticks(concat(items('Aplicar_a_cada_uno')?['Fecha Inicio'], 'T', first(outputs('Obtener_elementos_2')?['body/value'])?['Open'], ':00'))
)

min(
  ticks(concat(items('Aplicar_a_cada_uno')?['Fecha Fin'], 'T', items('Aplicar_a_cada_uno')?['Hora Fin'], ':00')),
  ticks(concat(items('Aplicar_a_cada_uno')?['Fecha Fin'], 'T', first(outputs('Obtener_elementos_2')?['body/value'])?['Close'], ':00'))
)

if(
  less(outputs('FinReal'), outputs('InicioReal')),
  0,
  div(sub(outputs('FinReal'), outputs('InicioReal')), 600000000)
)

Title eq '@{items('Apply_to_each')?[Área]}'
