if(
  or(empty(items('Apply_to_each')?['Fecha Inicio']), empty(items('Apply_to_each')?['Hora Inicio'])),
  null,
  max(
    ticks(concat(items('Apply_to_each')?['Fecha Inicio'], 'T', items('Apply_to_each')?['Hora Inicio'], ':00')),
    ticks(concat(items('Apply_to_each')?['Fecha Inicio'], 'T', first(outputs('Get_matriz')?['body/value'])?['Open'], ':00'))
  )
)

if(
  or(empty(items('Apply_to_each')?['Fecha Fin']), empty(items('Apply_to_each')?['Hora Fin'])),
  null,
  min(
    ticks(concat(items('Apply_to_each')?['Fecha Fin'], 'T', items('Apply_to_each')?['Hora Fin'], ':00')),
    ticks(concat(items('Apply_to_each')?['Fecha Fin'], 'T', first(outputs('Get_matriz')?['body/value'])?['Close'], ':00'))
  )
)

if(
  empty(outputs('DuracionRealMinutos')),
  json('{"Estado":"","Motivo":""}'),
  if(
    less(outputs('DuracionRealMinutos'), 30),
    json('{"Estado":"No aplica","Motivo":"< 30 mins"}'),
    if(
      less(outputs('PorcentajeAfectacion'), 50),
      json('{"Estado":"No aplica","Motivo":"<50% de afectación del equipo"}'),
      json('{"Estado":"Aplica","Motivo":""}')
    )
  )
)
