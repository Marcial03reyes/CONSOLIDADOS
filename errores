Compose FechaFin ISO:
concat(
  substring(items('Apply_to_each')?['FechaFin'],6,4),
  '-',
  substring(items('Apply_to_each')?['FechaFin'],3,2),
  '-',
  substring(items('Apply_to_each')?['FechaFin'],0,2)
)

Compose Close Ajustado:
if(
  equals(first(outputs('Get_matriz')?['body/value'])?['Close'],'24:00'),
  '23:59',
  first(outputs('Get_matriz')?['body/value'])?['Close']
)
