if(
  or(empty(items('Apply_to_each')?['Fecha Inicio']), empty(items('Apply_to_each')?['Hora Inicio']), empty(items('Apply_to_each')?['Fecha Fin']), empty(items('Apply_to_each')?['Hora Fin'])),
  null,
  if(
    less(outputs('Fin_Real'), outputs('Inicio_Real')),
    0,
    div(sub(outputs('Fin_Real'), outputs('Inicio_Real')), 600000000)
  )
)

if(
  or(empty(items('Apply_to_each')?['ER']), equals(items('Apply_to_each')?['ER'], 0)),
  null,
  mul(div(float(items('Apply_to_each')?['Afectación del equipo']), float(items('Apply_to_each')?['ER'])), 100)
)

if(
  empty(outputs('DuracionRealMinutos')),
  json('{"Estado":"","Motivo":""}'),
  if(
    less(outputs('DuracionRealMinutos'), 30),
    json('{"Estado":"No aplica","Motivo":"< 30 mins"}'),
    if(
      less(outputs('PorcentajeAfectacion'), 50),
      json('{"Estado":"No aplica","Motivo":"<50% de afectación del equipo"}'),
      json('{"Estado":"Aplica","Motivo":""}')
    )
  )
)
